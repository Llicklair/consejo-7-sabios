{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Consejo: invocar (mock, animado)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m", "consejo.cli",
        "${input:atasco}",
        "--mode", "mock",
        "--rounds", "3",
        "--speed", "0.3"
      ],
      "options": {
        "env": { "PYTHONPATH": "src" }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true,
        "focus": true
      },
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Consejo: invocar (claude-code, animado, 2 rondas)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m", "consejo.cli",
        "${input:atasco}",
        "--mode", "claude-code",
        "--cc-model", "opus",
        "--rounds", "2",
        "--speed", "0.3"
      ],
      "options": {
        "env": { "PYTHONPATH": "src" }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Consejo: invocar (claude-code, CONSENSUS conversacional)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m", "consejo.cli",
        "${input:atasco}",
        "--mode", "claude-code",
        "--cc-model", "opus",
        "--consensus",
        "--consensus-rounds", "20",
        "--speed", "0.3"
      ],
      "options": {
        "env": { "PYTHONPATH": "src" }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true,
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Consejo: invocar (mock, headless)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m", "consejo.cli",
        "${input:atasco}",
        "--mode", "mock",
        "--no-ui",
        "--rounds", "3"
      ],
      "options": {
        "env": { "PYTHONPATH": "src" }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Consejo: tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/", "-v"],
      "options": {
        "env": { "PYTHONPATH": "src" }
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ],
  "inputs": [
    {
      "id": "atasco",
      "type": "promptString",
      "description": "¿Qué quieres que el Consejo debata?",
      "default": "Mejora general del proyecto"
    }
  ]
}
